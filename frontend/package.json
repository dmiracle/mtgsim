{
  "name": "mtgsim-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/ui",
    "packages/viewer",
    "packages/flashcards"
  ],
  "scripts": {
    "dev": "npm run dev -w @mtgsim/viewer",
    "dev:flashcards": "npm run dev -w @mtgsim/flashcards",
    "build": "npm run build -w @mtgsim/viewer",
    "build:flashcards": "npm run build -w @mtgsim/flashcards",
    "storybook": "npm run storybook -w @mtgsim/ui",
    "build-storybook": "npm run build-storybook -w @mtgsim/ui",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "^10.3.1",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0"
  }
}
